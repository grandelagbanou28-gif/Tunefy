**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*backup.xcworkspace
**/ios/**/*ccmacros
**/ios/**/*.xcuserdata
