# Google Services & secrets
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
android/app/release-keystore.jks
android/key.properties
macos/Runner/GoogleService-Info.plist

# Backend secrets
**/.env
backend/.env

# Build-time API keys (--dart-define-from-file=secrets.json)
secrets.json

# Local stream resolver: ffmpeg copy (84 Mo, fetched by the script) and the
# merged clip cache. Both are machine-local rebuildable artefacts, never source.
backend/ffmpeg_bin/
backend/media_cache/

# Generated by the Flutter tool — regenerated on every build.
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
macos/Flutter/GeneratedPluginRegistrant.swift
**/problems/problems-report.html

# Stray tool output from debugging sessions — never source.
analyze*.txt
build_out*.txt
build_output.txt
buildlog.txt
dump.txt
check_file.py
screen_check.png
SUMMARY.md

# Duplicate of the app icon (identical bytes to assets/icon.png), removed.
assets/hivefy_icon.png

# Lockfiles of vendored packages are generated locally.
packages/*/pubspec.lock

# Android debug signing key
debug.keystore
*.keystore
*.jks
