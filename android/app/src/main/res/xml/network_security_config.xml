<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTP clair autorisé uniquement sur la loopback : le serveur yt-dlp local
  (127.0.0.1:9877 / 8000, adb reverse) n'est pas chiffré. Tout le reste
  (API distantes, CDNs) doit passer par HTTPS — bloque les MITM réseau.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Hôte de l'émulateur Android vers la machine hôte -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
